{
  "name": "preppy-v2",
  "version": "2.0.0",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "node scripts/install-natives.js",
    "package:win": "vite build && electron-builder --win --x64",
    "release:win": "vite build && electron-builder --win --x64 --publish=always"
  },
  "build": {
    "appId": "com.preppy.v2",
    "productName": "Preppy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/renderer/**/*.map"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ],
      "artifactName": "Preppy-portable.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "adamsieht",
      "repo": "preppy-v2"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@reduxjs/toolkit": "^2.3.0",
    "better-sqlite3": "^11.0.0",
    "chart.js": "^4.4.0",
    "dayjs": "^1.11.13",
    "electron-log": "^5.2.0",
    "react": "^18.3.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.0",
    "react-redux": "^9.1.0",
    "react-router-dom": "^6.26.0",
    "react-simple-keyboard": "^3.8.12",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.5.0",
    "electron": "^32.0.0",
    "electron-builder": "^26.15.2",
    "eslint": "^9.0.0",
    "happy-dom": "^20.9.0",
    "postcss": "^8.5.15",
    "prebuild-install": "^7.1.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^2.1.9"
  }
}
